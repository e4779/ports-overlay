# audiomuse environment — mirrors upstream native launcher (child_env.py)
# Home: docs/freebsd/26-audiomuse-ai.org. All vars are read at import time by config.py.

# --- media server ---
MEDIASERVER_TYPE=navidrome
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
# or token instead of user/password:
NAVIDROME_API_KEY=
MUSIC_LIBRARIES=

# --- database (external PostgreSQL; DATABASE_URL is derived from these five) ---
DATABASE_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=audiomuse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=audiomuse

# --- paths (mirror child_env.py of the native build) ---
APP_DATA_DIR=/var/db/audiomuse
TEMP_DIR=/var/db/audiomuse/temp_audio
NUMBA_CACHE_DIR=/var/db/audiomuse/numba
BACKUP_DIR=/var/db/audiomuse/backup
RESTORE_LOG_DIR=/var/db/audiomuse/backup
LYRICS_MODEL_DIR=/var/db/audiomuse/model
EMBEDDING_MODEL_PATH=/var/db/audiomuse/model/musicnn_embedding.onnx
PREDICTION_MODEL_PATH=/var/db/audiomuse/model/musicnn_prediction.onnx
CLAP_AUDIO_MODEL_PATH=/var/db/audiomuse/model/model_epoch_36.onnx
CLAP_TEXT_MODEL_PATH=/var/db/audiomuse/model/clap_text_model.onnx
CLAP_SAE_ENCODER_PATH=/var/db/audiomuse/model/dclap_sae_k20_d1024_best_encoder.onnx
CLAP_SAE_MODEL_PATH=/var/db/audiomuse/model/dclap_sae_k20_d1024_best_decoder.onnx
NEURAL_FINGERPRINT_MODEL_PATH=/var/db/audiomuse/model/neural_fingerprint.onnx
NEURAL_FINGERPRINT_CODEBOOK_PATH=/var/db/audiomuse/model/neural_fingerprint_pq.npz
LYRICS_WHISPER_MODEL_DIR=/var/db/audiomuse/model/whisper-small-onnx
SILERO_VAD_ONNX_PATH=/var/db/audiomuse/model/silero_vad.onnx
LYRICS_GTE_ONNX_PATH=/var/db/audiomuse/model/gte-multilingual-base-int8.onnx
LYRICS_GTE_TOKENIZER_DIR=/var/db/audiomuse/model/gte-multilingual-base
HF_HOME=/var/db/audiomuse/model/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- plugins / process ---
PLUGINS_ENABLED=true
PLUGINS_DIR=/var/db/audiomuse/plugins
# our rc.d supervises; no supervisorctl exists on FreeBSD
DISABLE_FLASK_RESTART=true

TZ=UTC
