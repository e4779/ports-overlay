#!/bin/sh
# libretranslate — self-hosted MT API for SillyTavern (runbook 28).
# waitress server inside the `libretranslate` CLI; G5 daemon wrapper.

# PROVIDE: libretranslate
# REQUIRE: sshd
# KEYWORD: shutdown

. /etc/rc.subr

name=libretranslate
rcvar=libretranslate_enable

load_rc_config ${name}

: ${libretranslate_enable:=NO}
: ${libretranslate_svcj:=YES}
: ${libretranslate_user:=_libretranslate}
: ${libretranslate_group:=_libretranslate}
: ${libretranslate_bind:=127.0.0.1}
: ${libretranslate_port:=5000}
: ${libretranslate_datadir:=/var/db/libretranslate}
# NB: ${name}_flags is RESERVED — rc.subr puts it right after command= (daemon(8)),
# which chokes on app flags. Use libretranslate_extra_flags for app args.
: ${libretranslate_extra_flags:=--load-only en,ru}

# Zen5 OpenBLAS workaround exported here: an env(1)-prefix inside
# command_args does NOT survive the svcj start path (scar 2026-11-10,
# runbook 28) — a plain export is inherited by the whole process tree.
export OPENBLAS_CORETYPE=Haswell

pidfile=/var/run/libretranslate/libretranslate.pid
command=/usr/sbin/daemon
# HOME pins argos models to datadir/.local/share/argos-translate.
# OPENBLAS_CORETYPE=Haswell: FreeBSD OpenBLAS picks a broken kernel for
# Zen 5 (9700X) -> SIGSEGV in ct2 on long inputs; AVX2 kernels are fine
# (scar 2026-11-10, runbook 28).
# -P (supervisor pidfile), NOT -p: with daemon -r, stopping the child alone
# makes the supervisor respawn it forever; service stop must kill the
# supervisor. pidfile tracks the supervisor (run_rc_command kill works).
command_args="-r -R 5 -o /var/log/libretranslate/libretranslate.log -P ${pidfile} env HOME=${libretranslate_datadir} OPENBLAS_CORETYPE=Haswell %%PREFIX%%/bin/libretranslate --host ${libretranslate_bind} --port ${libretranslate_port} ${libretranslate_extra_flags}"

start_precmd=libretranslate_prestart

libretranslate_prestart()
{
	for _d in /var/run/libretranslate /var/log/libretranslate /var/db/libretranslate; do
		[ -d "${_d}" ] || install -d -o ${libretranslate_user} -g ${libretranslate_group} "${_d}"
	done
}

run_rc_command "$1"
