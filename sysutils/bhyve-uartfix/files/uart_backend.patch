+static void
+uart_read_hup(struct uart_softc *sc)
+{
+
+	/*
+	 * The peer delivering characters to the read side has gone away
+	 * (EOF on a pipe or fifo, hangup on a tty).  Unlike the TCP socket
+	 * backend there is no way to re-establish the connection, so disarm
+	 * the read event and stop polling the descriptor: kqueue reports a
+	 * descriptor at EOF as permanently readable and would otherwise
+	 * spin the mevent thread.  Console output is unaffected.
+	 */
+	if (sc->input_closed)
+		return;
+	if (sc->mev != NULL) {
+		mevent_delete(sc->mev);
+		sc->mev = NULL;
+	}
+	sc->input_closed = true;
+	warnx("uart: console input disconnected; "
+	    "input disabled until the VM is restarted");
+}
